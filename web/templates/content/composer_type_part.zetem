{# The type-dependent part of the composer form; also the type editor's Form preview (inside a disabled fieldset). #}
    {% if(count($fields)): %}
    <fieldset {% if($locked): %}disabled{% endif %}>
      <legend>{{{t('Values')}}}</legend>
      <div class="row">
        {% foreach($fields as $f): %}
        <label data-src="field:{{{$f['id']}}}">{{{$f['label']}}}{% if($f['required']): %} *{% endif %}
          {% if($f['type'] == 'date'): %}
          <input type="date" name="fields[{{{$f['id']}}}]" value="{{{$f['value']}}}">
          {% else: %}
          <input type="text" name="fields[{{{$f['id']}}}]" value="{{{$f['value']}}}" placeholder="{{{$f['placeholder']}}}" size="40" maxlength="1000">
          {% endif %}
        </label>
        {% endforeach %}
      </div>
    </fieldset>
    {% endif %}

    {% if(count($feature_defs) && !$locked): %}
    <fieldset class="features"><legend>{{{t('Case features')}}}</legend>
      <p class="muted">{{{t('Adding a feature switches on the lines it brings; removing it puts them back. You can still edit everything by hand.')}}}</p>
      {% foreach($feature_defs as $fd): %}
      {% if($fd['on']): %}<span class="chip">{{{$fd['label']}}} <button type="submit" name="action" value="feature_remove" formaction="{{rel_url('/documents/' . $doc_id . '?feature=' . $fd['id'])}}" class="chip-x" title="{{{t('Remove')}}}" onclick="this.form.feature.value='{{{$fd['id']}}}'">&times;</button></span>
      {% else: %}<button type="submit" name="action" value="feature_add" class="chip-add" onclick="this.form.feature.value='{{{$fd['id']}}}'">+ {{{$fd['label']}}}</button>{% endif %}
      {% endforeach %}
      <input type="hidden" name="feature" value="">
    </fieldset>
    {% endif %}

    {% if(count($sections) > 1): %}<p class="sec-all"><span role="button" tabindex="0" class="tt-btn" data-sec-all="open">{{{t('Expand all')}}}</span> <span role="button" tabindex="0" class="tt-btn" data-sec-all="close">{{{t('Collapse all')}}}</span></p>{% endif %}
    {% foreach($sections as $sec): %}
    <fieldset class="section{% if($sec['collapsed']): %} collapsed{% endif %}" data-src="{{{$sec['src']}}}" {% if($locked): %}disabled{% endif %}>
      <legend class="sec-toggle" tabindex="0" title="{{{t('Show or hide this section')}}}"><span class="sec-arrow"></span>{{{$sec['label'] ?: ($sec['heading'] ?: $sec['slot'])}}} <span class="muted">{{{$sec['slot']}}} &middot; {{{$sec['layout']}}}</span> {% if($sec['summary'] !== ''): %}<span class="sec-count muted">&middot; {{{$sec['summary']}}}</span>{% endif %}</legend>
      <div class="sec-body">
      {% if($sec['optional']): %}
      <label class="inline"><input type="checkbox" name="sections_on[{{{$sec['id']}}}]" value="1" {% if($sec['on']): %}checked{% endif %}> {{{t('Include this section')}}}</label>
      {% endif %}
      {% if($sec['is_med']): %}
      <table class="medrows" id="meds-{{{$sec['id']}}}" data-sec="{{{$sec['id']}}}">
        <thead><tr><th>{{{t('Drug')}}}</th><th>{{{t('Dose')}}}</th><th>{{{t('Frequency')}}}</th><th>{{{t('Days')}}}</th><th>{{{t('Notes')}}}</th><th></th></tr></thead>
        <tbody>
        {% foreach($sec['meds'] as $mi => $m): %}
        <tr>
          <td><input type="text" name="meds[{{{$sec['id']}}}][{{{$mi}}}][name]" value="{{{$m['name']}}}"></td>
          <td><input type="text" name="meds[{{{$sec['id']}}}][{{{$mi}}}][dose]" value="{{{$m['dose']}}}" size="8"></td>
          <td><textarea name="meds[{{{$sec['id']}}}][{{{$mi}}}][freq]" rows="1">{{{$m['freq']}}}</textarea></td>
          <td><input type="text" name="meds[{{{$sec['id']}}}][{{{$mi}}}][days]" value="{{{$m['days']}}}" size="4"></td>
          <td><textarea name="meds[{{{$sec['id']}}}][{{{$mi}}}][notes]" rows="1">{{{$m['notes']}}}</textarea></td>
          <td><button type="button" class="med-del" title="{{{t('Remove')}}}">&times;</button></td>
        </tr>
        {% endforeach %}
        </tbody>
      </table>
      <p>
        <select class="med-add" data-table="meds-{{{$sec['id']}}}" data-drugs="{{{$sec['drug_json']}}}">
          <option value="">{{{t('Add from the drug library...')}}}</option>
          {% foreach($sec['drug_groups'] as $gname => $gdrugs): %}
          <optgroup label="{{{$gname}}}">{% foreach($gdrugs as $dg): %}<option value="{{{$dg['id']}}}">{{{$dg['name']}}} {{{$dg['dose']}}}</option>{% endforeach %}</optgroup>
          {% endforeach %}
        </select>
        <button type="button" class="med-blank" data-table="meds-{{{$sec['id']}}}">{{{t('Add an empty row')}}}</button>
        <span class="muted">{{{t('In a cell, {br} starts a new line.')}}}</span>
      </p>
      {% endif %}
      {% foreach($sec['blocks'] as $b): %}
      <div class="block {% if($b['on']): %}on{% else: %}off{% endif %}" data-src="block:{{{$b['id']}}}">
        <div class="block-pick">
          {% if($b['in_group']): %}
          <label class="inline"><input type="radio" name="groups[{{{$b['group']}}}]" value="{{{$b['id']}}}" {% if($b['on']): %}checked{% endif %}> {{{$b['label'] ?: ''}}}</label>
          {% else: %}
          <label class="inline"><input type="checkbox" name="blocks_on[{{{$b['id']}}}]" value="1" {% if($b['on']): %}checked{% endif %}> {{{$b['label'] ?: ''}}}</label>
          {% endif %}
        </div>
        {% if($b['is_latex']): %}
        <textarea rows="{{{max(2, min(8, intdiv(mb_strlen($b['text']), 90) + 1))}}}" readonly class="latex-block">{{{$b['text']}}}</textarea>
        <span class="muted">{{{t('LaTeX block: it can be switched on or off here; its text is changed in the type editor.')}}}</span>
        {% else: %}
        <textarea name="btext[{{{$b['id']}}}]" rows="{{{max(2, min(8, intdiv(mb_strlen($b['text']), 90) + 1))}}}">{{{$b['text']}}}</textarea>
        {% endif %}
        {% if($b['edited']): %}<span class="edited">{{{t('edited for this document')}}}</span>{% endif %}
      </div>
      {% endforeach %}
      {% if($sec['blocks'] && $sec['blocks'][0]['in_group']): %}
      <label class="inline"><input type="radio" name="groups[{{{$sec['blocks'][0]['group']}}}]" value="" {% if($sec['none_on']): %}checked{% endif %}> {{{t('None')}}}</label>
      {% endif %}
      {% if(count($sec['suggestions'])): %}
      <div class="suggestions"><span class="muted">{{{t('From your earlier documents')}}}:</span>
        {% foreach($sec['suggestions'] as $sg): %}
        <button type="button" class="suggestion" data-target="extra-{{{$sec['id']}}}" data-insert="{{{$sg['text']}}}" title="{{{t('Insert; used in')}}} {{{$sg['uses']}}} {{{t('documents')}}}">{{{mb_strimwidth($sg['text'], 0, 90, '…')}}}</button>
        {% endforeach %}
      </div>
      {% endif %}
      <details {% if($sec['extra']): %}open{% endif %}>
        <summary>{{{$sec['is_list'] ? t('Add items (one per line)') : t('Add free text')}}}</summary>
        <textarea id="extra-{{{$sec['id']}}}" name="extra[{{{$sec['id']}}}]" rows="{{{$sec['rows']}}}" placeholder="{% if($sec['placeholder'] !== ''): %}{{{$sec['placeholder']}}}{% else: %}{{{t('Written for this document only')}}}{% endif %}">{{{$sec['extra']}}}</textarea>
      </details>
      </div>
    </fieldset>
    {% endforeach %}

