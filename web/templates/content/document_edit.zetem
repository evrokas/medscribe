{% attach_library('type-editor') %}
<div class="composer cx-page splitpane" data-split-key="medscribe.composer.layout">
  <form method="post" action="{{rel_url('/documents/' . $doc['id'])}}" class="composer-form split-left cx" id="composer-form" data-sentences-url="{{rel_url('/documents/' . $doc['id'] . '/sentences')}}" data-known="{{{$known_json}}}" data-locked="{{{$locked ? '1' : ''}}}">
    {{ csrf_field() }}
    <div class="cx-head">
        <a class="cx-back" href="{{rel_url('/documents')}}">&lsaquo; {{{t('Documents')}}}</a>
        <h2>#{{{$doc['id']}}} {{{$type_label}}}</h2>
        {{ ui_status_pill($doc['status']) }}
        <span class="cx-dirty" id="cx-dirty" hidden>&#9679; {{{t('Unsaved changes')}}}</span>
        <span class="cx-head-actions">
          <span class="cx-views" role="tablist" aria-label="{{{t('View')}}}">
            <button type="button" role="tab" data-view="write" aria-selected="true" title="{{{t('The document as it will read')}}}">{{{t('Write')}}}</button>
            <button type="button" role="tab" data-view="form" aria-selected="false" title="{{{t('Every sentence and value as a field')}}}">{{{t('Form')}}}</button>
          </span>
          {% if($doc['status'] == 'issued' || $doc['status'] == 'withdrawn'): %}<a class="ms-btn" href="{{rel_url('/documents/' . $doc['id'] . '/history')}}">{{{t('History')}}}</a>{% endif %}
          {% if($is_doctor): %}<a class="ms-btn" href="{{rel_url('/documents/' . $doc['id'] . '/issue')}}">{{{$locked ? t('Issue page') : t('Issue...')}}}</a>{% endif %}
        </span>
    </div>

    {% if($unsaved): %}<p class="notice">{{{t('These changes are NOT saved yet: a PDF was being built. Save again.')}}}</p>{% endif %}
    {% if($busy && !$locked): %}<p class="notice">{{{t('A PDF of this document is being built; saving waits until it is done.')}}}</p>{% endif %}
    {% if($locked): %}<p class="notice">{{{t('This document is locked.')}}} {% if($doc['doc_code']): %}<code>{{{$doc['doc_code']}}}</code>{% endif %}</p>{% endif %}
    {% if($doc['status'] == 'code_reserved'): %}<p class="notice">{{{t('Code reserved')}}}: <code>{{{$doc['doc_code']}}}</code>. {{{t('Edits keep the code; the final PDF is built again at the next step.')}}}</p>{% endif %}

    {% if($has_patient): %}
    <section class="cx-banner" id="cx-patient" data-gr="{{{$is_gr ? '1' : ''}}}" data-optional="{{{$patient_optional ? '1' : ''}}}">
      <div class="cx-banner-row">
        <span class="cx-avatar" aria-hidden="true" id="cx-initials">{{{$initials}}}</span>
        <div class="cx-who">
          <div class="cx-name" id="cx-p-name">{% if(($p['name'] ?? '') !== ''): %}{{{$p['name']}}}{% else: %}<span class="muted">{{{$patient_optional ? t('No patient (optional)') : t('No patient name yet')}}}</span>{% endif %}</div>
          <div class="ms-sub" id="cx-p-sub" data-m="{{{t('Male')}}}" data-f="{{{t('Female')}}}" data-years="{{{t('years')}}}" data-noamka="{{{t('AMKA not given')}}}" data-src="{{{$from_zpms ? t('From ZPMS') : t('Typed by hand')}}}"></div>
        </div>
        <span class="cx-warn" id="cx-gender-warn" hidden>{{{t('Gender needed for the Greek text')}}}</span>
        {% if(!$locked): %}<button type="button" class="ms-btn cx-toggle" aria-expanded="false" aria-controls="cx-patient-edit">{{{($p['name'] ?? '') === '' && $patient_optional ? t('Add') : t('Edit patient')}}}</button>{% endif %}
      </div>
      <fieldset class="cx-edit" id="cx-patient-edit" hidden {% if($locked): %}disabled{% endif %}>
        <legend class="ms-sub">{{{t('Changes here apply to this document only')}}}{% if($from_zpms): %} ({{{t('nothing is written back to ZPMS')}}}){% endif %}</legend>
        <input type="hidden" name="patient[guid]" value="{{{$p['guid'] ?? ''}}}">
        <input type="hidden" name="patient[dob]" value="{{{$p['dob'] ?? ''}}}">
        <div class="ms-grid">
          <label class="ms-field ms-wide">{{{t('Name')}}} <input type="text" class="ms-input" name="patient[name]" value="{{{$p['name'] ?? ''}}}" maxlength="255"></label>
          <label class="ms-field">{{{t('Gender')}}}
            <select name="patient[gender]" class="ms-input">
              <option value="">-</option>
              <option value="M" {% if(($p['gender'] ?? '') == 'M'): %}selected{% endif %}>{{{t('Male')}}}</option>
              <option value="F" {% if(($p['gender'] ?? '') == 'F'): %}selected{% endif %}>{{{t('Female')}}}</option>
            </select>
          </label>
          <label class="ms-field">{{{t('Age')}}} <input type="text" class="ms-input" name="patient[age]" value="{{{$p['age'] ?? ''}}}" size="4" maxlength="16"></label>
          <label class="ms-field">AMKA <input type="text" class="ms-input" name="patient[amka]" value="{{{$p['amka'] ?? ''}}}" size="12" maxlength="11"></label>
        </div>
      </fieldset>
    </section>
    {% endif %}

    <section class="cx-line" id="cx-details">
      <div class="cx-banner-row">
        <span class="ms-sub">{{{t('Document')}}}</span>
        <span id="cx-d-sum" class="cx-sum" data-yes="{{{t('signature and stamp')}}}" data-no="{{{t('doctor details only')}}}" data-closing="{{{t('closing')}}}" data-to="{{{t('to')}}}"></span>
        {% if(!$locked): %}<button type="button" class="ms-btn cx-toggle" aria-expanded="false" aria-controls="cx-details-edit">{{{t('Edit')}}}</button>{% endif %}
      </div>
      <fieldset class="cx-edit" id="cx-details-edit" hidden {% if($locked): %}disabled{% endif %}>
        <div class="ms-grid">
          <label class="ms-field">{{{t('Clinic')}}}
            <select name="settings[clinic]" class="ms-input">
              {% foreach($clinics as $c): %}<option {% if(($s['clinic'] ?? '') == $c): %}selected{% endif %}>{{{$c}}}</option>{% endforeach %}
            </select>
          </label>
          <label class="ms-field">{{{t('Date')}}} <input type="date" class="ms-input" name="settings[date]" value="{{{$s['date'] ?? ''}}}"></label>
          <label class="ms-field ms-wide">{{{t('Printed title')}}} <input type="text" class="ms-input" name="settings[title]" value="{{{$s['title'] ?? ''}}}" maxlength="255" list="titles">
            <datalist id="titles">{% foreach($titles as $tt): %}<option value="{{{$tt}}}">{% endforeach %}</datalist></label>
          <label class="ms-field">{{{t('Closing')}}} <input type="text" class="ms-input" name="settings[closing]" value="{{{$s['closing'] ?? ''}}}" maxlength="255" list="closings">
            <datalist id="closings">{% foreach($closings as $cc): %}<option value="{{{$cc}}}">{% endforeach %}</datalist></label>
          <label class="ms-field">{{{t('Stamp')}}}
            <select name="settings[stamp]" class="ms-input">
              <option value="no" {% if(($s['stamp'] ?? 'no') != 'yes'): %}selected{% endif %}>{{{t('Doctor details only')}}}</option>
              <option value="yes" {% if(($s['stamp'] ?? '') == 'yes'): %}selected{% endif %}>{{{t('Signature and stamp')}}}</option>
            </select>
          </label>
          {% if($has_recipient): %}<label class="ms-field ms-wide">{{{t('Recipient')}}} <input type="text" class="ms-input" name="settings[recipient]" value="{{{$s['recipient'] ?? ''}}}" maxlength="500"></label>{% endif %}
        </div>
        <details class="cx-adv">
          <summary>{{{t('Advanced')}}}</summary>
          <label class="ms-field">{{{t('Letterhead version')}}}
            <select name="base_release_id" class="ms-input">
              {% foreach($releases as $rl): %}<option value="{{{$rl['id']}}}" {% if($rl['id'] == $doc['base_release_id']): %}selected{% endif %}>B{{{$rl['number']}}}</option>{% endforeach %}
            </select>
          </label>
          <p class="ms-sub">{{{t('Only before the code is reserved: the QR address of the code is checked against the letterhead chosen then.')}}}</p>
        </details>
      </fieldset>
    </section>

    {{ $type_part }}

    <p class="palette"><label class="inline">{{{t('Insert a field into the text you are writing')}}}:
      <select id="token-palette"><option value="">@...</option>{% foreach($tokens as $tk): %}<option value="{{{$tk}}}">@{{{$tk}}}</option>{% endforeach %}</select></label></p>

    <div class="cx-bar">
      <div class="cx-checks">
        {% if($n_checks == 0): %}
        <span class="cx-ok">&#10003; {{{t('All checks pass')}}}</span>
        {% else: %}
        <button type="button" class="cx-checks-btn" aria-expanded="false" aria-controls="cx-checks-list">&#9888; {{{$n_checks}}} {{{$n_checks == 1 ? t('needs attention') : t('need attention')}}}</button>
        <ul class="cx-checks-list" id="cx-checks-list" hidden>
          {% foreach($checks as $c): %}<li class="check check-{{{$c['level']}}}" data-src="{{{$c['src'] ?? ''}}}" tabindex="0" title="{{{t('Show where')}}}">{{{$c['msg']}}}</li>{% endforeach %}
        </ul>
        {% endif %}
      </div>
      <span class="cx-state" id="cx-state" data-unsaved="{{{t('Unsaved changes')}}}" data-saving="{{{t('Saving...')}}}" data-building="{{{t('Building preview...')}}}">{% if($unsaved): %}<span class="cx-bad">{{{t('Not saved: a PDF was being built')}}}</span>{% elseif(!$locked): %}{{{t('Saved')}}}{% endif %}</span>
      {% if(!$locked): %}
      <span class="cx-actions">
        <button type="submit" class="ms-btn cx-del" form="delete-form" title="{{{t('Delete this draft')}}}">{{{t('Delete draft')}}}</button>
        {% if($ready): %}
        <button type="submit" name="action" value="draft" class="ms-btn">{{{t('Back to draft')}}}</button>
        {% else: %}
        <button type="submit" name="action" value="ready" class="ms-btn">{{{t('Ready for review')}}}</button>
        {% endif %}
        <button type="submit" name="action" value="save" class="ms-btn">{{{t('Save')}}}</button>
        <button type="submit" name="action" value="preview" class="ms-btn ms-primary">{{{t('Save and preview')}}}</button>
      </span>
      {% endif %}
    </div>
  </form>

  <div class="composer-splitter" role="separator" aria-orientation="vertical" tabindex="0" title="{{{t('Drag to change the width of the preview')}}}">
    <button type="button" data-dir="left" title="{{{t('Widen the preview')}}}">&#9664;</button>
    <button type="button" data-dir="right" title="{{{t('Narrow the preview')}}}">&#9654;</button>
  </div>

  <div class="composer-preview split-right cx-pv">
    <div class="cx-pv-head">
      <strong>{{{t('Preview PDF')}}}</strong>
      {% if($build): %}<span class="ms-sub" title="{{{$build['cdate']}}}">{{{$build['status'] == 'ok' ? t('built') : t('failed')}}} {{{$build_when}}}</span>{% endif %}
      <span class="pill pill-review cx-stale" id="cx-stale" {% if(!$stale): %}hidden{% endif %} title="{{{t('The document changed after this PDF was built')}}}">{{{t('Out of date')}}}</span>
      <span class="cx-pv-actions">
        {% if($pdf_url && $is_a5): %}
        <details class="cx-print"><summary class="ms-btn">{{{t('Print')}}}</summary>
          <div class="cx-menu"><span class="ms-sub">{{{t('Two A5 per A4 sheet')}}}</span>
            <a href="{{rel_url('/documents/' . $doc['id'] . '/print.pdf?mode=seq')}}" target="_blank">{{{t('pages in order')}}}</a>
            <a href="{{rel_url('/documents/' . $doc['id'] . '/print.pdf?mode=dup')}}" target="_blank">{{{t('each page twice')}}}</a></div>
        </details>
        {% endif %}
        {% if(!$locked): %}<button type="submit" form="composer-form" name="action" value="preview" class="ms-btn">{{{t('Save and preview')}}}</button>{% endif %}
      </span>
    </div>
    {% if($pdf_url): %}
    <iframe src="{{rel_url($pdf_url)}}" title="{{{t('Preview')}}}"></iframe>
    {% elseif($build): %}
    <pre class="log">{{{$build['log_tail']}}}</pre>
    {% else: %}
    <p class="muted">{{{t('No preview yet. Press "Save and preview".')}}}</p>
    {% endif %}
    <p class="ms-sub cx-pv-note">{{{t('The real PDF from the last "Save and preview". It has a frame where the QR goes; the real QR is added in the final copy.')}}}</p>
  </div>

  <script src="{{rel_url('/js/splitter.js')}}"></script>
  <script src="{{rel_url('/js/sections.js')}}"></script>
  <script src="{{rel_url('/js/composer.js')}}"></script>
  <script src="{{rel_url('/js/type_tree.js')}}"></script>
  <script src="{{rel_url('/js/type_chips.js')}}"></script>
  <script src="{{rel_url('/js/composer_write.js')}}"></script>
  <script>
  (function () {
    var last = null;
    document.querySelectorAll('.composer textarea').forEach(function (t) { t.addEventListener('focus', function () { last = t; }); });
    function insert(t, text) {
      var s = t.selectionStart || t.value.length, e = t.selectionEnd || t.value.length;
      t.value = t.value.slice(0, s) + text + t.value.slice(e); t.focus(); t.selectionStart = t.selectionEnd = s + text.length;
    }
    document.querySelectorAll('.suggestion').forEach(function (b) { b.addEventListener('click', function () {
      var t = document.getElementById(b.dataset.target); var d = t.closest('details'); if (d) d.open = true;
      t.value = (t.value.trim() ? t.value.replace(/\s+$/, '') + '\n\n' : '') + b.dataset.insert; t.focus();
    }); });
    function addRow(tableId, d) {
      var tb = document.querySelector('#' + tableId + ' tbody'), sec = document.getElementById(tableId).dataset.sec, i = Date.now() % 1e9 + tb.children.length;
      var tr = document.createElement('tr'), mk = function (k, tag, size) {
        var td = document.createElement('td'), el = document.createElement(tag === 'ta' ? 'textarea' : 'input');
        el.name = 'meds[' + sec + '][' + i + '][' + k + ']'; if (tag === 'ta') el.rows = 1; else { el.type = 'text'; if (size) el.size = size; }
        el.value = (d && d[k]) || ''; td.appendChild(el); tr.appendChild(td); };
      mk('name', 'in'); mk('dose', 'in', 8); mk('freq', 'ta'); mk('days', 'in', 4); mk('notes', 'ta');
      var td = document.createElement('td'), b = document.createElement('button'); b.type = 'button'; b.className = 'med-del'; b.textContent = '\u00d7'; td.appendChild(b); tr.appendChild(td);
      tb.appendChild(tr);
      return tr;
    }
    window.MSMeds = {addRow: addRow};   // the Write view's "Add medication" menu (composer_write.js)
    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('med-del')) e.target.closest('tr').remove();
      if (e.target.classList.contains('med-blank')) addRow(e.target.dataset.table, null);
    });
    document.querySelectorAll('.med-add').forEach(function (sel) { sel.addEventListener('change', function () {
      var list = JSON.parse(sel.dataset.drugs), d = list.filter(function (x) { return x.id === sel.value; })[0];
      if (d) addRow(sel.dataset.table, d); sel.value = '';
    }); });
    var pal = document.getElementById('token-palette');
    if (pal) pal.addEventListener('change', function () { if (pal.value && last) insert(last, '@' + pal.value); pal.value = ''; });
  })();
  </script>
  {% if(!$locked): %}
  <form method="post" action="{{rel_url('/documents/' . $doc['id'] . '/delete')}}" id="delete-form" class="delete-form" hidden onsubmit="return confirm('{{{t('Delete this draft?')}}}')">
    {{ csrf_field() }}
  </form>
  {% endif %}
</div>
