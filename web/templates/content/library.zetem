{# The content pool (D8/D16; composer plan §5.5): one card per text. Forms and actions as before (web/pool.php). #}
<div class="ms-page">
  <div class="ms-head"><h2>{{{t('Library')}}}</h2></div>
  <p class="ms-sub">{{{t('Text from your issued documents (written or edited by you), by slot. Patient details are stored as @fields so they take the next document\'s values. Promote the good ones; hide what should not be suggested. Withdrawn documents leave the pool.')}}}</p>
  <nav class="ms-chips" aria-label="{{{t('Filter by slot')}}}">
    <a class="ms-chip{% if($slot == ''): %} on{% endif %}" href="{{rel_url('/library')}}">{{{t('All')}}}</a>
    {% foreach($slots as $sl): %}<a class="ms-chip{% if($slot == $sl['slot']): %} on{% endif %}" href="{{rel_url('/library?slot=' . rawurlencode($sl['slot']))}}">{{{$sl['slot']}}} <span class="ms-count lib-n">{{{$sl['n']}}}</span></a>{% endforeach %}
  </nav>
  {% if(count($blocks) == 0): %}
  <p class="ms-card pad muted">{{{t('Nothing yet. Text you write or edit in a document joins the pool when that document is issued.')}}}</p>
  {% else: %}
  <div class="lib-grid">
    {% foreach($blocks as $b): %}
    <article class="ms-card lib-card{% if($b['hidden']): %} lib-hidden{% endif %}">
      <div class="lib-meta">
        <span class="pill {{{$b['tier'] == 'library' ? 'pill-issued' : 'pill-draft'}}}">{{{$b['tier'] == 'library' ? t('Library') : t('History')}}}</span>
        {% if($b['hidden']): %}<span class="pill pill-withdrawn">{{{t('hidden')}}}</span>{% endif %}
        <code class="ms-sub">{{{$b['slot']}}}</code>
      </div>
      <p class="lib-text">{{{$b['text']}}}</p>
      <div class="lib-foot">
        <span class="ms-sub">{{{t('Used')}}} {{{$b['uses']}}}&times; &middot; {{{t('last')}}} {{{doc_when((string)$b['last_used'])}}}</span>
        <form method="post" action="{{rel_url('/library')}}" class="inline-form">{{ csrf_field() }}<input type="hidden" name="id" value="{{{$b['id']}}}"><input type="hidden" name="slot" value="{{{$slot}}}">
          {% if($b['tier'] == 'history'): %}<button name="action" value="promote" class="ms-btn">{{{t('Promote')}}}</button>{% else: %}<button name="action" value="demote" class="ms-btn">{{{t('Demote')}}}</button>{% endif %}
          {% if($b['hidden']): %}<button name="action" value="show" class="ms-btn">{{{t('Show')}}}</button>{% else: %}<button name="action" value="hide" class="ms-btn">{{{t('Hide')}}}</button>{% endif %}
        </form>
      </div>
    </article>
    {% endforeach %}
  </div>
  {% endif %}
</div>
