{% attach_library('type-editor') %}
<div class="page-placeholder te te-review">
  <div class="te-head">
    <div class="te-title">
      <a class="te-crumb" href="{{rel_url('/types')}}">{{{t('Types')}}} &rsaquo;</a>
      <a class="te-crumb" href="{{rel_url('/types/' . $kind . '/' . $name . '?v=' . $cur['version'])}}">{{{$type_label}}} &rsaquo;</a>
      <h2>{{{t('Review')}}} v{{{$cur['version']}}}</h2>
      {% if($cur['status'] == 'released'): %}<span class="te-pill te-pill-released">{{{t('Released')}}}</span>{% else: %}<span class="te-pill te-pill-draft">{{{t('Draft')}}}</span>{% endif %}
    </div>
  </div>

  <div class="te-cols">
    <div class="te-col-main">
      <section class="te-card">
        <h3>{{{t('What changes')}}}{% if($base): %} <span class="muted">v{{{$base['version']}}} &rarr; v{{{$cur['version']}}}</span>{% endif %}</h3>
        {% if(!$base): %}<p class="muted">{{{t('The first version: everything in it is new.')}}}</p>{% endif %}
        {% if($base && $diff['count'] == 0): %}<p class="muted">{{{t('No change in the definition.')}}}</p>{% endif %}
        {% foreach($diff['groups'] as $g): %}
        <div class="te-dgroup">
          <h4>{{{$g['title']}}}</h4>
          <ul class="te-ditems">
            {% foreach($g['items'] as $it): %}
            <li class="te-ditem te-d-{{{$it['op']}}}">
              <div class="te-dline">
                <span class="te-dop">{{{t(ucfirst($it['op']))}}}</span>
                <span class="te-dwhat">{{{t($it['what'])}}}</span>
                {% if(!empty($it['where'])): %}<span class="muted">{{{$it['where']}}} &rsaquo;</span>{% endif %}
                {% if(empty($it['text'])): %}<span class="te-dlabel">{{{$it['label']}}}</span>{% endif %}
                <code class="te-did">{{{$it['id']}}}</code>
                {% if(!empty($it['note'])): %}<span class="muted">{{{$it['note']}}}</span>{% endif %}
              </div>
              {% if(!empty($it['text'])): %}
              <div class="te-dtext">{% if($it['text'][0] === null): %}<ins>{{{$it['text'][1]}}}</ins>{% elseif($it['text'][1] === null): %}<del>{{{$it['text'][0]}}}</del>{% else: %}{% foreach(types_word_diff($it['text'][0], $it['text'][1]) as $w): %}{% if($w['op'] == '+'): %}<ins>{{{$w['t']}}}</ins>{% elseif($w['op'] == '-'): %}<del>{{{$w['t']}}}</del>{% else: %}{{{$w['t']}}}{% endif %}{% endforeach %}{% endif %}</div>
              {% endif %}
              {% if(!empty($it['keys'])): %}
              <table class="te-dkeys">
                {% foreach($it['keys'] as $k => $ch): %}<tr><th>{{{$k}}}</th><td><del>{{{types_cut(types_show_value($ch[0]), 160)}}}</del></td><td>&rarr;</td><td><ins>{{{types_cut(types_show_value($ch[1]), 160)}}}</ins></td></tr>{% endforeach %}
              </table>
              {% endif %}
            </li>
            {% endforeach %}
          </ul>
        </div>
        {% endforeach %}
        {% if($base): %}<p class="te-foot"><a href="{{rel_url('/types/' . $kind . '/' . $name . '?a=' . $base['version'] . '&b=' . $cur['version'] . '&v=' . $cur['version'])}}">{{{t('Raw JSON diff')}}}</a></p>{% endif %}
      </section>
    </div>

    <div class="te-col-side">
      <section class="te-card">
        <h3>{{{t('Checks')}}}</h3>
        {% if($clean): %}<p class="te-ok">&#10003; {{{t('Valid; the sample renders without problems (male and female).')}}}</p>{% endif %}
        <ul class="te-checks">
          {% foreach($checks as $c): %}<li class="te-check-{{{$c['level']}}}">{{{$c['msg']}}}</li>{% endforeach %}
        </ul>
        {% if($pins): %}
        <p class="muted">{{{t('Shared components:')}}}</p>
        <ul class="te-checks">
          {% foreach($pins as $p): %}<li>{{{$p['label']}}}: {% if($p['version']): %}v{{{$p['version']}}}{% else: %}{{{t('unknown version')}}}{% endif %}{% if($p['latest'] && $p['version'] && $p['latest'] > $p['version']): %} <span class="muted">(v{{{$p['latest']}}} {{{t('is the latest')}}})</span>{% endif %}</li>{% endforeach %}
        </ul>
        {% endif %}
      </section>

      <section class="te-card">
        <h3>{{{t('Release')}}}</h3>
        {% if($cur['status'] == 'released'): %}
        <p>v{{{$cur['version']}}} {{{t('is released and can no longer change.')}}}</p>
        {% else: %}
        {% if($kind == 'shared'): %}
        <p>{{{t('Releasing a shared component changes no type: each type keeps the version it pins until its pin is updated (a new type version, released on its own).')}}}</p>
        {% else: %}
        <p>{{{t('Documents created from now on use')}}} v{{{$cur['version']}}}. {{{t('The existing documents')}}} ({{{$docs}}}) {{{t('keep their own version.')}}} v{{{$cur['version']}}} {{{t('cannot be edited after release.')}}}</p>
        {% endif %}
        {% if($has_errors): %}<p class="te-check-error">{{{t('This version has errors (above): fix them in a new version before releasing.')}}}</p>{% endif %}
        <p class="muted">{{{t('Saved in the database only: after releasing, bring it into types/*.json with php bin/export_types.php and commit.')}}}</p>
        <form method="post" action="{{rel_url('/types/' . $kind . '/' . $name)}}">
          {{ csrf_field() }}
          <input type="hidden" name="version" value="{{{$cur['version']}}}">
          <label class="te-confirm"><input type="checkbox" name="confirm" value="1" required {% if($has_errors): %}disabled{% endif %}> {{{t('I have read the changes and checked the print preview')}}}</label>
          <div class="actions">
            <button type="submit" name="action" value="release" class="primary" {% if($has_errors): %}disabled{% endif %}>{{{t('Release')}}} v{{{$cur['version']}}}</button>
            <a class="btn" href="{{rel_url('/types/' . $kind . '/' . $name . '?v=' . $cur['version'])}}">{{{t('Keep as draft')}}}</a>
          </div>
        </form>
        {% endif %}
      </section>

      <section class="te-card">
        <h3>{{{t('Versions')}}}</h3>
        <ul class="te-vers">
          {% foreach($versions as $v): %}
          <li{% if($v['version'] == $cur['version']): %} class="on"{% endif %}>
            <a href="{{rel_url('/types/' . $kind . '/' . $name . '/review?v=' . $v['version'])}}">v{{{$v['version']}}}</a>
            <span class="badge badge-{{{$v['status'] == 'released' ? 'issued' : 'draft'}}}">{{{$v['status']}}}</span>
            <span class="muted">{{{$v['cdate']}}} &middot; {{{$v['cuser']}}} &middot; {{{$v['docs']}}} {{{t('doc.')}}}</span>
            <div>{{{$v['note']}}}</div>
          </li>
          {% endforeach %}
        </ul>
      </section>
    </div>
  </div>
</div>
