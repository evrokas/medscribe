{# The approved revisions of a document (composer plan §5.4): one card per revision with its files and "Rebuild and verify". #}
<div class="ms-page narrow ix">
  <div class="ms-head">
    <a class="cx-back" href="{{rel_url('/documents/' . $doc['id'])}}">&lsaquo; {{{t('Back to the document')}}}</a>
    <h2>{{{t('History')}}} #{{{$doc['id']}}}{% if($doc['doc_code']): %} &middot; <code>{{{$doc['doc_code']}}}</code>{% endif %}</h2>
    {{ ui_status_pill($doc['status']) }}
  </div>
  {% if(count($revs) == 0): %}
  <p class="ms-card pad muted">{{{t('No approved revision yet. Drafts are not revisions.')}}}</p>
  {% else: %}
  {% foreach($revs as $r): %}
  <section class="ms-card pad ix-rev">
    <div class="ix-rev-head">
      <h3>{{{t('Revision')}}} {{{$r['revision']}}}</h3>
      <span class="ms-sub">{{{$r['status']}}} &middot; {{{t('approved')}}} {{{$r['cdate']}}} {{{t('by')}}} {{{$r['by']}}}</span>
      <span class="ix-actions">
        <a class="ms-btn" href="{{rel_url('/documents/' . $doc['id'] . '/rev/' . $r['revision'] . '/pdf')}}" target="_blank">PDF</a>
        <a class="ms-btn" href="{{rel_url('/documents/' . $doc['id'] . '/rev/' . $r['revision'] . '/tex')}}" target="_blank">.tex</a>
        {% if($is_doctor): %}
        <form method="post" action="{{rel_url('/documents/' . $doc['id'] . '/history')}}" class="inline-form">
          {{ csrf_field() }}<input type="hidden" name="revision" value="{{{$r['revision']}}}">
          <button type="submit" class="ms-btn" title="{{{t('Build this revision again from its recorded files and check that the PDF is byte-identical')}}}">{{{t('Rebuild and verify')}}}</button>
        </form>
        {% endif %}
      </span>
    </div>
    <p class="ms-sub">PDF <code>{{{substr($r['pdf_sha256'], 0, 12)}}}</code></p>
    <details><summary>{{{t('Built with')}}} {{{count($r['files'])}}} {{{t('files')}}}{% if($r['env']): %} &middot; {{{$r['env']}}}{% endif %}</summary>
      <table class="ms-table">
      {% foreach($r['files'] as $f): %}<tr><td>{{{$f['name']}}}</td><td>v{{{$f['version']}}}</td><td><code>{{{substr($f['sha256'], 0, 12)}}}</code></td></tr>{% endforeach %}
      </table>
    </details>
  </section>
  {% endforeach %}
  {% endif %}
</div>
