<div class="page-placeholder">
    <div class="page-head">
        <h2>{{{t('Documents')}}}</h2>
        <a class="btn" href="{{rel_url('/documents/new')}}">{{{t('New document')}}}</a>
    </div>
    {% if(count($docs) == 0): %}
    <p class="muted">{{{t('No documents yet.')}}}{% if($types == 0): %} {{{t('There is no released document type: run bin/import_types.php --release.')}}}{% endif %}</p>
    {% else: %}
    <table class="status-table list">
        <tr><th>#</th><th>{{{t('Patient')}}}</th><th>{{{t('Type')}}}</th><th>{{{t('Code')}}}</th><th>{{{t('Status')}}}</th><th>{{{t('By')}}}</th><th>{{{t('Updated')}}}</th></tr>
        {% foreach($docs as $d): %}
        <tr>
            <td><a href="{{rel_url('/documents/' . $d['id'])}}">{{{$d['id']}}}</a></td>
            <td><a href="{{rel_url('/documents/' . $d['id'])}}">{{{$d['patient_name'] ?: '-'}}}</a></td>
            <td>{{{$d['type_name']}}}</td>
            <td><code>{{{$d['doc_code']}}}</code></td>
            <td>{{ ui_status_pill($d['status']) }}</td>
            <td>{{{$d['cuser']}}}</td>
            <td>{{{$d['udate'] ?: $d['cdate']}}}</td>
        </tr>
        {% endforeach %}
    </table>
    {% endif %}
</div>
