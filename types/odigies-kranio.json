      "blocks": [
        {
          "id": "s7_b1",
          "text": "**Επικοινωνήστε άμεσα με τον ιατρό εάν εμφανίσετε:**",
          "default": true
        }
      ]
    },
    {
      "id": "s8",
      "slot": "import.odigies-kranio.s8",
      "layout": "itemize",
      "blocks": [
        {
          "id": "s8_b1",
          "text": "Έντονο ή αυξανόμενο πόνο.",
          "default": true
        },
        {
          "id": "s8_b2",
          "text": "Εμέτους, θολή όραση ή διπλωπία.",
          "default": true
        },
        {
          "id": "s8_b3",
          "text": "Πυρετό.",
          "default": true
        },
        {
          "id": "s8_b4",
          "text": "Ερυθρότητα ή εκροή από την τομή.",
          "default": true
        },
        {
          "id": "s8_b5",
          "text": "Αδυναμία ή αιμωδίες στο σώμα που δεν προϋπήρχαν.",
          "default": true
        }
      ]
