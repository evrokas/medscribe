{
  "format": 1,
  "name": "praktiko",
  "label": "Πρακτικό χειρουργείου",
  "lang": "gr",
  "paper": "a4",
  "imported": "kit tpl-praktiko.tex",
  "fields": {
    "surgery_date": {
      "type": "date",
      "label": "Ημερομηνία επέμβασης"
    },
    "surgeon": {
      "type": "text",
      "label": "Χειρουργός",
      "default": "Ευάγγελος Μ. Ρόκας"
    },
    "assistant": {
      "type": "text",
      "label": "Βοηθός χειρουργού",
      "placeholder": "ονοματεπώνυμο"
    },
    "anesthetist": {
      "type": "text",
      "label": "Αναισθησιολόγος",
      "placeholder": "ονοματεπώνυμο"
    },
    "anesthesia": {
      "type": "text",
      "label": "Αναισθησία",
