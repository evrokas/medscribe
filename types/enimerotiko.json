{
  "format": 1,
  "name": "enimerotiko",
  "label": "Ενημερωτικό σημείωμα / εξιτήριο",
  "lang": "gr",
  "paper": "a4",
  "imported": "kit tpl-enimerotiko.tex",
  "shared": {
    "drug-library": "latest"
  },
  "fields": {
    "admission_date": {
      "type": "date",
      "label": "Ημ. εισαγωγής"
    },
    "discharge_date": {
      "type": "date",
      "label": "Ημ. εξιτηρίου"
    },
    "surgery_date": {
      "type": "date",
      "label": "Ημ. χειρουργείου"
    },
    "symptoms": {
      "type": "text",
      "label": "Λόγος (συμπτώματα)",
      "placeholder": "συμπτώματα"
    },
    "medical_history": {
      "type": "text",
      "label": "Ατομικό αναμνηστικό",
      "placeholder": "παθήσεις, αντιπηκτική αγωγή, βηματοδότης, αλλεργίες"
    },
    "admission_picture": {
      "type": "text",
      "label": "Κλινική εικόνα κατά την εισαγωγή",
      "placeholder": "GCS 15, νευρολογική εξέταση"
    },
    "imaging": {
      "type": "text",
      "label": "Απεικόνιση",
      "placeholder": "CT / MRI"
    },
    "findings": {
      "type": "text",
      "label": "Ευρήματα απεικόνισης",
      "placeholder": "ευρήματα"
    },
    "transfer_hospital": {
      "type": "text",
      "label": "Νοσοκομείο μεταφοράς",
      "placeholder": "νοσοκομείο"
    }
  },
  "sections": [
    {
      "id": "s1",
      "slot": "import.enimerotiko.patient",
      "layout": "patient-info",
      "blocks": [
        {
          "id": "s1_b1",
          "text": "@admission_date",
          "default": true,
          "label": "Ημ. Εισαγωγής",
          "datefmt": "d-m-Y"
        },
        {
          "id": "s1_b2",
          "text": "@discharge_date",
          "default": true,
          "label": "Ημ. Εξιτηρίου",
          "datefmt": "d-m-Y"
        },
        {
          "id": "s1_b3",
          "text": "@surgery_date",
          "default": false,
          "label": "Ημ. Χειρουργείου",
          "datefmt": "d-m-Y"
        }
      ]
    },
    {
      "id": "s2",
      "slot": "import.enimerotiko.s2",
      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s2_b1",
          "group": "opening",
          "text": "{Ο|Η} ασθενής διακομίσθηκε στα ΤΕΠ της κλινικής στις @admission_date λόγω @symptoms.",
          "default": true
        },
        {
          "id": "s2_b3",
          "group": "opening",
          "text": "{Ο|Η} ασθενής εξετάσθηκε για πρώτη φορά στις @admission_date λόγω @symptoms.",
          "default": false
        },
        {
          "id": "s2_b2",
          "text": "Από το ατομικό αναμνηστικό: @medical_history.",
          "default": true,
          "inline": true
        }
      ],
      "heading": "Ιστορικό"
    },
    {
      "id": "s3",
      "slot": "import.enimerotiko.s3",
      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s3_b1",
          "text": "Κατά την εισαγωγή {ο|η} ασθενής παρουσίαζε @admission_picture.",
          "default": true
        },
        {
          "id": "s3_b2",
          "text": "Από τον απεικονιστικό έλεγχο με @imaging διαπιστώθηκε @findings.",
          "default": true,
          "inline": true
        }
      ],
      "heading": "Κλινική εικόνα και απεικονιστικός έλεγχος"
    },
    {
      "id": "s4",
      "slot": "import.enimerotiko.s4",
      "layout": "paragraphs",
      "blocks": [],
      "heading": "Πορεία",
      "placeholder": "Θεραπεία, χειρουργείο (ημερομηνία, κλινική, είδος), μετεγχειρητική πορεία, επιπλοκές, εξετάσεις κατά τη νοσηλεία."
    },
    {
      "id": "s5",
      "slot": "import.enimerotiko.s5",
      "layout": "paragraphs",
      "blocks": [],
      "heading": "Παρούσα κατάσταση",
      "placeholder": "Νευρολογική εικόνα κατά το εξιτήριο, κινητοποίηση, αυτοεξυπηρέτηση, καθετήρες."
    },
    {
      "id": "s6",
      "slot": "import.enimerotiko.s6",
      "layout": "paragraphs",
      "blocks": [],
      "heading": "Σχέδιο",
      "placeholder": "π.χ. Μεταφέρεται κατόπιν συνεννόησης σε κέντρο αποκατάστασης για εντατικό πρόγραμμα ενδυνάμωσης. / Θα ξεκινήσουν συνεδρίες χημειοθεραπείας και ακτινοθεραπείας σε συνεννόηση με τον ογκολόγο."
    },
    {
      "id": "s6b",
      "slot": "import.enimerotiko.s6b",
      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s6_b2",
          "text": "{Ο|Η} ασθενής, κατόπιν επιθυμίας των συγγενών, θα μεταφερθεί με ασθενοφόρο σε @transfer_hospital για περαιτέρω νοσηλεία.",
          "default": false
        }
      ]
    },
    {
      "id": "s8",
      "slot": "import.enimerotiko.s8",
      "layout": "itemize",
      "list_options": "[nosep]",
      "intro": "**Φαρμακευτική αγωγή:**",
      "blocks": [],
      "placeholder": "Ένα φάρμακο ανά γραμμή, π.χ.\nApotel 1000mg x 3\nOmeprazole 40mg x 2"
    },
    {
      "id": "meds",
      "slot": "import.enimerotiko.meds",
      "layout": "medtable",
      "library": "drug-library",
      "intro": "**Φαρμακευτική αγωγή:**",
      "optional": true,
      "default": false
    },
    {
      "id": "s9",
      "slot": "import.enimerotiko.s9",
      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s9_b2",
          "text": "Η φαρμακευτική αγωγή επισυνάπτεται.",
          "default": false
        }
      ]
    }
  ],
  "title": "Ενημερωτικό",
  "titles": [
    "Ενημερωτικό",
    "Ιατρική Έκθεση",
    "Ενημερωτικό Σημείωμα"
  ],
  "closing": "Ο ιατρός",
  "closings": [
    "Ο ιατρός"
  ],
  "stamp": "no",
  "reviewed": "2026-11-06"
}
