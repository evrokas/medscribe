      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s5_b1",
          "text": "Η επέμβαση πραγματοποιείται υπό **@f9 αναισθησία**.",
          "default": true
        },
        {
          "id": "s5_b2",
          "text": "@f10",
          "default": true,
          "inline": true
        },
        {
          "id": "s5_b3",
          "text": "Η διάρκεια της επέμβασης κυμαίνεται συνήθως από **@f11 ώρες**.",
          "default": true,
          "inline": true
        }
      ],
      "heading": "Περιγραφή της διαδικασίας",
      "numbered": true
    },
    {
      "id": "s6",
      "slot": "import.synainesi.s6",
      "layout": "paragraphs",
      "blocks": [
        {
          "id": "s6_b1",
          "text": "Παρά τη μέγιστη προσοχή και εμπειρία, κάθε χειρουργική επέμβαση ενέχει κινδύνους, οι οποίοι περιλαμβάνουν:",
          "default": true
