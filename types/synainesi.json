        {
          "id": "s3_b1",
          "text": "Η προτεινόμενη χειρουργική πράξη είναι η **@f5**@f6.",
          "default": true
        },
        {
          "id": "s3_b2",
          "text": "Στόχος της επέμβασης είναι:",
          "default": true,
